{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Train model",
      "type": "debugpy",
      "request": "launch",
      "module": "src.train",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "2. Predict (sample posts)",
      "type": "debugpy",
      "request": "launch",
      "module": "src.predict",
      "args": ["I love this phone!", "Worst service ever, never again", "Bhai ye app bakwas hai"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "3. Streamlit dashboard",
      "type": "debugpy",
      "request": "launch",
      "module": "streamlit",
      "args": ["run", "app.py"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    },
    {
      "name": "4. Run tests",
      "type": "debugpy",
      "request": "launch",
      "module": "pytest",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal"
    }
  ]
}
